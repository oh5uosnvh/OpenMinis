+++          sed -i 's/^          //' /tmp/notes.md
+++          gh release create "$TAG" "$APK_PATH" \
+++            --title "魔改版 ${APK_VERSION} (${APK_SHORT})" \
+++            --notes-file /tmp/notes.md \
+++            || gh release upload "$TAG" "$APK_PATH" --clobber
