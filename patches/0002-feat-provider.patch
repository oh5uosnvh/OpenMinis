diff --git a/src/android/app/src/main/java/com/openminis/app/ui/settings/mods/ProviderDetailTabbedScreen.kt b/src/android/app/src/main/java/com/openminis/app/ui/settings/mods/ProviderDetailTabbedScreen.kt
