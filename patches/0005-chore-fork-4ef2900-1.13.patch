++name: Build Android APK
++
++# [FORK] Builds the魔改 APK from the `mods` branch.
++#
++# Everything the APK needs beyond the git tree is produced HERE, because
++# upstream deliberately does not commit build artifacts (see BUILDING.md):
++#   * proot + libtalloc          → deps/build_proot.sh          (NDK, cached)
++#   * Alpine aarch64 rootfs      → scripts/prepare_android_sandbox.sh (cached)
++#   * rclone.aar                 → scripts/fork/prepare-rclone.sh (gomobile,
++#                                  falls back to a 501 stub so one flaky Go
++#                                  build can't sink the whole APK)
++#   * provider-customization.properties → copied from the .example (empty values
++#                                  compile and run; only Claude OAuth needs a
++#                                  real value)
++
++on:
++  workflow_dispatch:
++    inputs:
++      build_type:
++        description: "Gradle build type"
++        type: choice
++        default: release
++        options: [release, debug]
++      rclone:
++        description: "rclone.aar (real = full remote backup, stub = disabled)"
++        type: choice
++        default: real
++        options: [real, stub]
++      make_release:
++        description: "Publish the APK as a GitHub Release"
++        type: boolean
++        default: true
++  push:
++    branches: [mods]
++    paths:
++      - "src/android/**"
++      - "src/shared/**"
++      - "deps/**"
++      - "scripts/**"
++      - ".github/workflows/build-apk.yml"
++
++permissions:
++  contents: write
++
++concurrency:
++  group: build-apk-${{ github.ref }}
++  cancel-in-progress: true
++
++jobs:
++  build:
++    runs-on: ubuntu-latest
++    timeout-minutes: 90
++
++    env:
++      BUILD_TYPE: ${{ inputs.build_type || 'release' }}
++      RCLONE_MODE: ${{ inputs.rclone || 'real' }}
++      # Pinned via the fork's init script, NOT build.gradle.kts — see
++      # scripts/fork/ndk-version.init.gradle.kts.
++      FORK_NDK_VERSION: "28.1.13356709"
++
++    steps:
++      - name: Checkout (with submodules)
++        uses: actions/checkout@v4
++        with:
++          submodules: recursive
++          fetch-depth: 0
++
++      - name: Set up JDK 17
++        uses: actions/setup-java@v4
++        with:
++          distribution: temurin
